{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"c:@M@RevenueCat@objc(cs)RCSubscriptionInfo(py)description","title":"description","roleHeading":"Instance Property","symbolKind":"property","role":"symbol","modules":[{"name":"RevenueCat"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"description","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}]},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst","macOS"],"tokens":[{"kind":"keyword","text":"override"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"description"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Calling this property directly is discouraged. Instead, convert an"},{"type":"text","text":" "},{"type":"text","text":"instance of any type to a string by using the "},{"type":"codeVoice","code":"String(describing:)"},{"type":"text","text":" "},{"type":"text","text":"initializer. This initializer works with any type, and uses the custom"},{"type":"text","text":" "},{"type":"codeVoice","code":"description"},{"type":"text","text":" property for types that conform to"},{"type":"text","text":" "},{"type":"codeVoice","code":"CustomStringConvertible"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":null,"code":["struct Point: CustomStringConvertible {","    let x: Int, y: Int","","    var description: String {","        return \"(\\(x), \\(y))\"","    }","}","","let p = Point(x: 21, y: 30)","let s = String(describing: p)","print(s)","\/\/ Prints \"(21, 30)\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The conversion of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" to a string in the assignment to "},{"type":"codeVoice","code":"s"},{"type":"text","text":" uses the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Point"},{"type":"text","text":" type’s "},{"type":"codeVoice","code":"description"},{"type":"text","text":" property."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/RevenueCat\/documentation\/RevenueCat","doc:\/\/RevenueCat\/documentation\/RevenueCat\/SubscriptionInfo"]]},"abstract":[{"type":"text","text":"A textual representation of this instance."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RevenueCat\/documentation\/RevenueCat\/SubscriptionInfo\/description"},"kind":"symbol","variants":[{"paths":["\/documentation\/revenuecat\/subscriptioninfo\/description"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://RevenueCat/documentation/RevenueCat/SubscriptionInfo":{"role":"symbol","abstract":[{"type":"text","text":"Subscription purchases of the Customer"}],"type":"topic","title":"SubscriptionInfo","url":"\/documentation\/revenuecat\/subscriptioninfo","navigatorTitle":[{"text":"SubscriptionInfo","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubscriptionInfo","kind":"identifier"}],"identifier":"doc:\/\/RevenueCat\/documentation\/RevenueCat\/SubscriptionInfo","kind":"symbol"},"doc://RevenueCat/documentation/RevenueCat/SubscriptionInfo/description":{"url":"\/documentation\/revenuecat\/subscriptioninfo\/description","abstract":[{"type":"text","text":"A textual representation of this instance."}],"role":"symbol","title":"description","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"description","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"kind":"symbol","identifie