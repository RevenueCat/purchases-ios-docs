{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"RevenueCat"}],"symbolKind":"property","roleHeading":"Instance Property","externalID":"c:@M@RevenueCat@objc(cs)RCStoreTransaction(py)description","title":"description","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"description"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"override"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"description"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}],"platforms":["iOS","iPadOS","Mac Catalyst","macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Calling this property directly is discouraged. Instead, convert an"},{"type":"text","text":" "},{"type":"text","text":"instance of any type to a string by using the "},{"type":"codeVoice","code":"String(describing:)"},{"type":"text","text":" "},{"type":"text","text":"initializer. This initializer works with any type, and uses the custom"},{"type":"text","text":" "},{"type":"codeVoice","code":"description"},{"type":"text","text":" property for types that conform to"},{"type":"text","text":" "},{"type":"codeVoice","code":"CustomStringConvertible"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["struct Point: CustomStringConvertible {","    let x: Int, y: Int","","    var description: String {","        return \"(\\(x), \\(y))\"","    }","}","","let p = Point(x: 21, y: 30)","let s = String(describing: p)","print(s)","\/\/ Prints \"(21, 30)\""]},{"inlineContent":[{"type":"text","text":"The conversion of "},{"type":"codeVoice","code":"p"},{"type":"text","text":" to a string in the assignment to "},{"type":"codeVoice","code":"s"},{"type":"text","text":" uses the"},{"type":"text","text":" "},{"type":"codeVoice","code":"Point"},{"type":"text","text":" type’s "},{"type":"codeVoice","code":"description"},{"type":"text","text":" property."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/RevenueCat\/documentation\/RevenueCat","doc:\/\/RevenueCat\/documentation\/RevenueCat\/StoreTransaction"]]},"abstract":[{"type":"text","text":"A textual representation of this instance."}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RevenueCat\/documentation\/RevenueCat\/StoreTransaction\/description"},"kind":"symbol","variants":[{"paths":["\/documentation\/revenuecat\/storetransaction\/description"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://RevenueCat/documentation/RevenueCat/StoreTransaction":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"StoreTransaction"}],"url":"\/documentation\/revenuecat\/storetransaction","abstract":[{"type":"text","text":"Abstract class that provides access to properties of a transaction."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/RevenueCat\/documentation\/RevenueCat\/StoreTransaction","isActive":true},{"type":"text","text":"s can represent transactions from StoreKit 1, StoreKit 2 or"},{"type":"text","text":" "},{"type":"text","text":"transactions made from other places, like Stripe, Google Play or Amazon Store."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"StoreTransaction"}],"title":"StoreTransaction","kind":"symbol","role":"symbol","identifier":"doc:\/\/RevenueCat\/documentation\/RevenueCat\/StoreTransaction"},"doc://RevenueCat/documentation/RevenueCat/StoreTransaction/description":{"fragments":[{"kind":"keyword","text"