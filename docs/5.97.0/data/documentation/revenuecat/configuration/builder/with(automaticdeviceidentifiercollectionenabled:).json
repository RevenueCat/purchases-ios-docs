{"abstract":[{"text":"Set ","type":"text"},{"type":"codeVoice","code":"automaticDeviceIdentifierCollectionEnabled"},{"text":". This is enabled by default.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/RevenueCat\/documentation\/RevenueCat","doc:\/\/RevenueCat\/documentation\/RevenueCat\/Configuration","doc:\/\/RevenueCat\/documentation\/RevenueCat\/Configuration\/Builder"]]},"kind":"symbol","identifier":{"url":"doc:\/\/RevenueCat\/documentation\/RevenueCat\/Configuration\/Builder\/with(automaticDeviceIdentifierCollectionEnabled:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst","macOS"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"with","kind":"identifier"},{"text":"(","kind":"text"},{"text":"automaticDeviceIdentifierCollectionEnabled","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"c:@M@RevenueCat@objc(cs)RCConfiguration","text":"Configuration","identifier":"doc:\/\/RevenueCat\/documentation\/RevenueCat\/Configuration","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:10RevenueCat13ConfigurationC7BuilderC","text":"Builder","identifier":"doc:\/\/RevenueCat\/documentation\/RevenueCat\/Configuration\/Builder","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Enable this setting to allow the collection of identifiers when setting the identifier for an"},{"type":"text","text":" "},{"type":"text","text":"attribution network. For example, when calling"},{"type":"reference","isActive":true,"identifier":"doc:\/\/RevenueCat\/documentation\/RevenueCat\/Pur